# User unit: ~/.config/systemd/user/horagon-keeper.service on the VPS (user horagon).
# `loginctl enable-linger horagon` (once, as root) keeps it running without a login session.
[Unit]
Description=Horagon keeper (devnet)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=%h/horagon/apps/keeper
EnvironmentFile=%h/horagon/.env.keeper
# Node 22 and pnpm live in ~/.local/bin, which must stay first in PATH: the VPS also has an
# older system Node.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=%h/horagon/apps/keeper/node_modules/.bin/tsx src/main.ts
Restart=always
RestartSec=5
# On SIGTERM main.ts ends the round after the step in progress, then exits. 120 s covers one
# executor wait (90 s) plus an RPC timeout; a tick or treasury step can hold several sends, so a
# longer step is killed. That is safe to resume: every send carries an `isDone` check against
# chain state, so the next start re-plans from the chain and does not repeat work that landed.
# A second SIGTERM exits at once.
KillSignal=SIGTERM
TimeoutStopSec=120
MemoryMax=768M

[Install]
WantedBy=default.target
