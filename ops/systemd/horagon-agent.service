# User unit: ~/.config/systemd/user/horagon-agent.service on the VPS (user horagon).
# The disclosed reference agent (README, "Reference agent"): a separate process from the keeper,
# with its own wallet (AGENT_KEYPAIR), reading the same env file. ops/deploy-keeper.sh installs
# this unit but never enables or starts it: start it by hand (docs/runbook.md, procedure J).
# Without AGENT_ENABLED=1 in .env.keeper it logs "agent disabled" and exits 0, and stays down.
[Unit]
Description=Horagon reference agent (devnet, disclosed team wallet)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/horagon/apps/keeper
EnvironmentFile=%h/horagon/.env.keeper
# Node 22 and pnpm live in ~/.local/bin, which must stay first in PATH: the VPS also has an
# older system Node.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=%h/horagon/apps/keeper/node_modules/.bin/tsx src/agent-main.ts
# A crash or a stall exit (KEEPER_STALL_SECS of silence) restarts it; a clean exit (disabled,
# or stopped by hand) does not.
Restart=on-failure
RestartSec=10
# On SIGTERM the agent ends the round in progress: at most one swap wait (90 s) plus an RPC
# timeout. A swap is never sent twice: TxSender looks its signatures up before any retry.
KillSignal=SIGTERM
TimeoutStopSec=120
MemoryMax=512M

[Install]
WantedBy=default.target
