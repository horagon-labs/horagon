{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/runbook.md",
        "$TURBO_ROOT$/scripts/count-fans.mjs",
        "$TURBO_ROOT$/scripts/count-fans.d.mts",
        "$TURBO_ROOT$/tests/fixtures/replay/*.json"
      ],
      "outputs": ["coverage/**"]
    }
  }
}
