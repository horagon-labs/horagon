# Every variable the apps and packages read (the spikes have their own: docs/spikes.md).
# Copy to `.env` for local runs and export it with `set -a; . ./.env; set +a`; on Vercel set
# them under Project Settings > Environment Variables; on the VPS they live in
# ~/horagon/.env.keeper (chmod 600). Devnet only: an RPC URL containing "mainnet" is refused
# everywhere.
#
# The same file is read by systemd and by the shell, so:
# - a comment goes on its own line (systemd reads `X=1 # note` as the value "1 # note");
# - a value with shell characters (& ? $ or a space) goes in single quotes;
# - an optional variable stays commented out: empty is not the same as unset, and several
#   are refused when empty. Only the ones left empty below are safe empty.

## Shared (web/API, keeper and horagon-ops)
HORAGON_RPC_URL=https://api.devnet.solana.com
HORAGON_CLUSTER=devnet
# Supabase: Project Settings > Database > Connection string > Transaction pooler (port 6543).
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
HORAGON_COLLATERAL_MINT=3WQ8hCqTNwjrh8WzE2XyoZoUrd1miPcwWfMkmFPUMEWZ
HORAGON_FAUCET_URL=https://pm-amm-devnet.vercel.app/api/faucet
# The public site; evidence URIs on chain point here (read by the API, `horagon-ops propose` and
# the keeper's auto-propose, which is off without it).
HORAGON_PUBLIC_URL=https://horagon.vercel.app
LOG_LEVEL=info

## Web and API (apps/web mounts packages/api)
# The sponsor hot key: base58 or a JSON byte array. Holds SOL only, a few SOL at most.
# Empty turns sponsored transactions off.
SPONSOR_SECRET_KEY=
# Local runs only (Vercel uses SPONSOR_SECRET_KEY): the ABSOLUTE path of a Solana CLI keypair
# file, read when SPONSOR_SECRET_KEY is unset. A relative path is refused: the web server runs
# in apps/web.
# SPONSOR_KEYPAIR=/path/to/horagon/.keys/sponsor.json
SPONSOR_DAILY_CAP_SOL=2
SPONSOR_TX_PER_HOUR=30
# New token accounts the sponsor opens a day; 26 covers YES and NO in 12 markets plus mUSDC.
# Each costs its rent for good (docs/security.md).
SPONSOR_ATAS_PER_WALLET_DAY=26
SPONSOR_ATAS_PER_IP_DAY=78
# Required. `openssl rand -hex 32`. Rotating it resets per-IP limits.
IP_HASH_SALT=
# Leave unset in production (same origin). Set to http://localhost:8787/api/v1 to point the
# web app at `pnpm --filter @horagon/api dev`. Read when the web app is built.
# NEXT_PUBLIC_API_BASE=
# The version the API reports when VERCEL_GIT_COMMIT_SHA (set by Vercel) is absent.
# HORAGON_VERSION=
# Port of `pnpm --filter @horagon/api dev` (default 8787).
# PORT=8787

## Keeper (apps/keeper, VPS)
# The sponsor's PUBLIC key (never the secret): the keeper records and watches the token accounts
# it paid for. Empty turns that off.
SPONSOR_PUBKEY=
# A second RPC the keeper (and horagon-ops) switch to when the first fails.
# HORAGON_RPC_BACKUP_URL=
# An https devnet RPC for the keeper's index reads only (indexer and ATA watch), e.g. a dedicated
# provider when the public endpoint rate-limits them. Unset reads through HORAGON_RPC_URL. Only
# its host is ever logged (docs/runbook.md, procedure L).
# HORAGON_INDEX_RPC_URL=
# wss:// URLs by position to the RPC URLs, comma-separated; an empty entry is derived.
# RPC_WS_URLS=
# A relative path starts at the repo root.
ATTESTOR_KEYPAIR=.keys/attestor.json
# Both or neither: one without the other is refused. Unset sends no alerts.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# espn: the real feed, and the only one the production keeper runs. replay: the recorded
# fixtures played as games shifted to REPLAY_TIPOFF, for a local Surfpool run with a local
# database only. Replay games are league NBA: on devnet their markets are counted NBA markets
# (docs/metrics.md) on the public board, and the reference agent trades them. A replay never runs
# on the production keeper (docs/runbook.md, "Replay").
KEEPER_FEED=espn
# Replay only: the fixture tag (1 to 6 letters or digits) and a UTC tip-off time such as
# 2026-11-24T00:30:00Z.
# REPLAY_TAG=
# REPLAY_TIPOFF=
# REPLAY_DIR=tests/fixtures/replay
# Local Surfpool run only: game time runs this many times faster (1 to 60).
REPLAY_SPEED=1
# ESPN_ARCHIVE_DIR=apps/keeper/data/archive
# ELO_FILE=apps/keeper/data/elo.json
# JSON overriding DEFAULT_TIMINGS in apps/keeper/src/planner.ts, in single quotes,
# e.g. '{"createLeadSecs":600}'.
# KEEPER_TIMINGS=
# Auto-propose: the attestor proposes each Final checked against a second source (docs/runbook.md,
# procedure K). on (the default), dry (pages what it would propose, sends and writes nothing; use
# it the first night after the deploy) or off (a guardian proposes every result by hand).
# KEEPER_AUTO_PROPOSE=on
# The second source: a balldontlie free-tier key (at least 8 characters), sent in a request
# header only and never logged. Unset: no second source, and every auto-proposal pages CHECK.
# Write it into .env.keeper on the VPS yourself.
# BALLDONTLIE_API_KEY=
# Seconds without a step, heartbeat, log line or RPC answer before the keeper exits so systemd
# restarts it (default 120, least 30). The check runs every 15 s, so it fires 120 to 135 s after
# the last sign of life at the default. ESPN fetches do not count as activity and the worst silent
# stretch is about 70 s, so values under about 90 can fire falsely.
# KEEPER_STALL_SECS=120
PRIORITY_MICROLAMPORTS=10000
HALT_PRIORITY_MICROLAMPORTS=200000
# Whole mUSDC each new market is seeded with (defaults: 1000 featured, 300 regular).
# SEED_FEATURED_USDC=
# SEED_REGULAR_USDC=

## horagon-ops (run by the guardian, not the service)
# Only for `horagon-ops init-config`.
# ATTESTOR_PUBKEY=

## Tests against a running Surfpool (tests/integration)
# HORAGON_IT_RPC=http://127.0.0.1:8899
# A throwaway keypair file that deployed the program there, never the devnet deployer.
# HORAGON_IT_ADMIN=.keys/it-admin.json

# ---------------------------------------------------------------------------------------------
# Reference agent (optional; apps/keeper/src/agent-main.ts, unit horagon-agent.service)
# It reads the same file as the keeper and reuses its Shared and Keeper variables (RPC,
# DATABASE_URL, HORAGON_COLLATERAL_MINT, TELEGRAM_*, HORAGON_FAUCET_URL, PRIORITY_MICROLAMPORTS).
# Off unless AGENT_ENABLED=1, and dry unless AGENT_DRY_RUN=0. Its wallet must be listed as
# team-burner in docs/metrics-wallets.json, in a public commit, before its first swap
# (docs/deploy.md). Values below are the defaults, except AGENT_ENABLED=1, which turns it on (the
# default is off); leave a line commented out rather than empty.
# ---------------------------------------------------------------------------------------------
# AGENT_ENABLED=1
# 1 (the default): log every decision and send nothing (no swap, no claim, no faucet claim).
# A dry run whose wallet holds less than its spend cap (AGENT_MAX_PER_GAME for each market read)
# plans against that cap and logs notional: true, and it never pages agent-musdc.
# 0: trade, from the wallet's real balance, claiming the faucet every hour. Write
# AGENT_DRY_RUN=0 only after a dry run (docs/deploy.md).
# AGENT_DRY_RUN=1
# Keypair file of the agent wallet, relative to the repo root. Never the sponsor.
# AGENT_KEYPAIR=.keys/agent.json
# 1: also trade the markets of games whose league is PRACTICE; 0 (the default): NBA only.
# Nothing creates a PRACTICE game yet. A keeper replay makes NBA games, which the agent trades
# whatever this says.
# AGENT_PRACTICE=0
# Seconds between rounds (at most half of KEEPER_STALL_SECS).
# AGENT_INTERVAL_SECS=20
# Stay out of a market while any other wallet traded it within this many seconds.
# AGENT_FAN_LAG_SECS=90
# Skip when the model probability is older than this many seconds.
# AGENT_MODEL_MAX_AGE_SECS=60
# No swap within this many seconds of a market's end_ts.
# AGENT_END_BUFFER_SECS=120
# Trade only when |model - price| is above this band.
# AGENT_BAND=0.04
# Stop this far short of the model (target = model - sign(gap) * stop short).
# AGENT_STOP_SHORT=0.02
# How close the sized swap lands to the target.
# AGENT_TOLERANCE=0.005
# Minimum-out slippage of each swap, in basis points.
# AGENT_SLIPPAGE_BPS=200
# Caps in mUSDC: per swap, per market (whole game), and the smallest swap it sends.
# AGENT_MAX_PER_SWAP=100
# AGENT_MAX_PER_GAME=2000
# AGENT_MIN_SWAP=1
# At most this many swaps per market.
# AGENT_MAX_SWAPS_PER_GAME=40
# After this many failed reads or sends in a row, pause for AGENT_PAUSE_SECS and alert.
# AGENT_MAX_FAILURES=5
# AGENT_PAUSE_SECS=600
# Balance alerts: SOL for fees, mUSDC to trade (agent-musdc pages in a live run only).
# AGENT_MIN_SOL=0.1
# AGENT_MIN_MUSDC=200
