{
  "name": "@horagon/sdk",
  "version": "0.0.0",
  "description": "TypeScript SDK for Horagon: in-play NBA prediction markets on pm-AMM (Solana devnet).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./math": {
      "import": {
        "types": "./dist/math.d.ts",
        "default": "./dist/math.js"
      },
      "require": {
        "types": "./dist/math.d.cts",
        "default": "./dist/math.cjs"
      }
    },
    "./model": {
      "import": {
        "types": "./dist/model.d.ts",
        "default": "./dist/model.js"
      },
      "require": {
        "types": "./dist/model.d.cts",
        "default": "./dist/model.cjs"
      }
    },
    "./evidence": {
      "import": {
        "types": "./dist/evidence.d.ts",
        "default": "./dist/evidence.js"
      },
      "require": {
        "types": "./dist/evidence.d.cts",
        "default": "./dist/evidence.cjs"
      }
    },
    "./pm-amm": {
      "import": {
        "types": "./dist/pm-amm.d.ts",
        "default": "./dist/pm-amm.js"
      },
      "require": {
        "types": "./dist/pm-amm.d.cts",
        "default": "./dist/pm-amm.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "buffer": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anchor-lang/core": "^1.2.2",
    "@horagon/pm-amm-vendor": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
